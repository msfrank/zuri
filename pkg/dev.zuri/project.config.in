{
    "build": {
        "cacheType": "Memory"
    },
    "targets": {
        "std": {
            "type": "Library",
            "specifier": "std-@PROJECT_VERSION@@zuri.dev",
            "libraryModules": [
                "/collections",
                "/flags",
                "/log",
                "/process",
                "/protocol/log",
                "/system",
                "/text",
                "/time",
                "/url",
            ],
            "settings": {
                "global": {
                    "sourceBasePath": "targets/std/src"
                },
                "tasks": {
                    "provide_plugin:/collections": {
                        "existingPlugin": {
                            "type": "ExternalFile",
                            "externalFilePath": "@ZURI_STD_COLLECTIONS_PLUGIN_FILEPATH@",
                        }
                    },
                    "provide_plugin:/log": {
                        "existingPlugin": {
                            "type": "ExternalFile",
                            "externalFilePath": "@ZURI_STD_LOG_PLUGIN_FILEPATH@",
                        }
                    },
                    "provide_plugin:/process": {
                        "existingPlugin": {
                            "type": "ExternalFile",
                            "externalFilePath": "@ZURI_STD_PROCESS_PLUGIN_FILEPATH@",
                        }
                    },
                    "provide_plugin:/resource": {
                        "existingPlugin": {
                            "type": "ExternalFile",
                            "externalFilePath": "@ZURI_STD_RESOURCE_PLUGIN_FILEPATH@",
                        }
                    },
                    "provide_plugin:/system": {
                        "existingPlugin": {
                            "type": "ExternalFile",
                            "externalFilePath": "@ZURI_STD_SYSTEM_PLUGIN_FILEPATH@",
                        }
                    },
                    "provide_plugin:/text": {
                        "existingPlugin": {
                            "type": "ExternalFile",
                            "externalFilePath": "@ZURI_STD_TEXT_PLUGIN_FILEPATH@",
                        }
                    },
                    "provide_plugin:/time": {
                        "existingPlugin": {
                            "type": "ExternalFile",
                            "externalFilePath": "@ZURI_STD_TIME_PLUGIN_FILEPATH@",
                        }
                    },
                }
            }
        },
        "fs": {
            "type": "Library",
            "specifier": "fs-@PROJECT_VERSION@@zuri.dev",
            "depends": ["std"],
            "libraryModules": [
                "/file",
                "/path",
                "/permission",
            ],
            "settings": {
                "global": {
                    "sourceBasePath": "targets/fs/src"
                },
                "tasks": {
                    "provide_plugin:/file": {
                        "existingPlugin": {
                            "type": "ExternalFile",
                            "externalFilePath": "@ZURI_FS_FILE_PLUGIN_FILEPATH@",
                        }
                    },
                    "provide_plugin:/path": {
                        "existingPlugin": {
                            "type": "ExternalFile",
                            "externalFilePath": "@ZURI_FS_PATH_PLUGIN_FILEPATH@",
                        }
                    },
                }

            }
        }
    }
}
